\label{tab:replan-frequency-appendix}
\begin{tabular}{lrrrr}
\toprule
& \multicolumn{4}{c}{plan length (env steps)} \\
\cmidrule(lr){2-5}
protocol (budget) & 5 & 25 (default) & 50 & 100 \\
\midrule
same-ep 25 (50)   & 64.0 $\pm$ 1.8 & \textbf{91.2} $\pm$ 1.0 & -- & -- \\
